# Copiar a un archivo privado de entorno; no guardar los valores reales en Git.
DJANGO_SETTINGS_MODULE=config.settings.prod
DEPLOYMENT_MODE=cloud
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=example.invalid
CSRF_TRUSTED_ORIGINS=https://example.invalid
PUBLIC_BASE_URL=https://example.invalid
DB_NAME=bigparty_cloud
DB_USER=bigparty_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
APP_VERSION=
APP_COMMIT=
ACCESS_SNAPSHOT_SIGNING_KEY=
ACCESS_SNAPSHOT_SOURCE=bigparty-cloud
SYNC_ENABLED=false
SYNC_NODE_UUID=
SYNC_SHARED_SECRET=
SYNC_PROTOCOL_VERSION=1
SYNC_COMPATIBLE_APP_VERSIONS=
SYNC_BATCH_SIZE=100
SYNC_MAX_BODY_BYTES=20971520
SYNC_ALLOW_HTTP_DEVELOPMENT=false
# Debe ser escribible por el proceso Cloud; logs sin payloads/secretos.
SYNC_LOG_ROOT=/var/log/bigparty

# Fase 4D. Carpetas privadas absolutas, separadas del checkout y media/static.
# Las tres claves DJANGO / SYNC / SNAPSHOT son obligatorias, incluso con sync apagado.
BACKUP_ROOT=/var/lib/bigparty/backups
BACKUP_SECONDARY_ROOT=/mnt/bigparty-secondary/backups
OPERATIONS_STATE_ROOT=/var/lib/bigparty/operations
PG_BIN_DIR=/usr/lib/postgresql/17/bin
BACKUP_KEEP_HOURLY=4
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6
BACKUP_TIMEOUT_SECONDS=1800
BACKUP_MAX_AGE_HOURS=8
MIN_FREE_DISK_GB=2
# JSON argv de adaptador revisado; vacío hasta elegir almacenamiento externo.
BACKUP_OFFSITE_COMMAND=
RECOVERY_MODE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN=20
RATE_LIMIT_PUBLIC=12
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_SYNC=120
SECURITY_HEADERS_ENABLED=true
SYNC_SHARED_SECRET_PREVIOUS=
# ISO 8601 con zona; vencimiento explícito dentro de 24 horas.
SYNC_SECRET_PREVIOUS_UNTIL=
PUBLIC_MEDIA_ROOT=/var/lib/bigparty/public-media
RESERVATION_PROOF_ROOT=/var/lib/bigparty/private/reservation-proofs
EVENT_PROOF_ROOT=/var/lib/bigparty/private/event-proofs
SUPPORT_LOG_ROOT=/var/log/bigparty
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
