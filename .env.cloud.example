# Copiar a un archivo privado de entorno; no guardar los valores reales en Git.
DJANGO_SETTINGS_MODULE=config.settings.prod
DEPLOYMENT_MODE=cloud
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=example.invalid
CSRF_TRUSTED_ORIGINS=https://example.invalid
PUBLIC_BASE_URL=https://example.invalid
DB_NAME=bigparty_cloud
DB_USER=bigparty_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
APP_VERSION=
APP_COMMIT=
ACCESS_SNAPSHOT_SIGNING_KEY=
ACCESS_SNAPSHOT_SOURCE=bigparty-cloud
SYNC_ENABLED=false
SYNC_NODE_UUID=
SYNC_SHARED_SECRET=
SYNC_PROTOCOL_VERSION=1
SYNC_COMPATIBLE_APP_VERSIONS=
SYNC_BATCH_SIZE=100
SYNC_MAX_BODY_BYTES=20971520
SYNC_ALLOW_HTTP_DEVELOPMENT=false
# Debe ser escribible por el proceso Cloud; logs sin payloads/secretos.
SYNC_LOG_ROOT=var/log
