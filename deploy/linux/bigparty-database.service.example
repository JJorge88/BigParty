[Unit]
Description=BIG PARTY database
After=postgresql.service network-online.target
[Service]
Type=oneshot
User=bigparty
Group=bigparty
WorkingDirectory=/opt/bigparty
EnvironmentFile=/etc/bigparty/cloud.env
ExecStart=/opt/bigparty/deploy/linux/backup-database.sh --secondary
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
