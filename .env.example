DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

DB_NAME=bigparty
DB_USER=bigparty_user
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

TIME_ZONE=America/Guatemala

# Desarrollo Mac: archivos de texto. Instalación física local: network.
PRINTER_BACKEND=debug
PRINTER_CONNECT_TIMEOUT=1
PRINTER_WRITE_TIMEOUT=2
PRINTER_STALE_SECONDS=120
# PRINTER_DEBUG_DIR=/ruta/local/var/print-jobs

# URL externa que usarán los enlaces privados de reservas y WhatsApp manual.
PUBLIC_BASE_URL=http://localhost:8000

# Invitación temporal en /ignaguracion. False devuelve 404 para retirarla.
PUBLIC_INVITATION_ENABLED=True
PUBLIC_INVITATION_STARTS_AT=2026-10-22T14:00:00-06:00

# Website público: imágenes relativas a static (opcional).
# PUBLIC_HERO_IMAGE=images/public/nightlife-hero.webp
# PUBLIC_SPORT_BAR_IMAGE=images/public/sport-bar.webp
# PUBLIC_DISCOTECA_IMAGE=images/public/discoteca.webp
# PUBLIC_PREMIUM_IMAGE=images/public/premium.webp

# Imágenes independientes opcionales; sin valor se muestra composición editorial.
# PUBLIC_RESERVATION_IMAGE=images/public/reservation.webp
# PUBLIC_EVENT_FALLBACK_IMAGE=images/public/event-fallback.webp
