# Copy to .env.local-node, edit locally, never commit the copy.
DJANGO_SETTINGS_MODULE=config.settings.local_node
DEPLOYMENT_MODE=local_node
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DB_NAME=bigparty
DB_USER=bigparty_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Explicit LAN hostname; loopback supports local health checks.
ALLOWED_HOSTS=pos.bigparty.lan,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://pos.bigparty.lan
LOCAL_NODE_NAME=BIG PARTY Principal
LOCAL_NODE_HOSTNAME=pos.bigparty.lan
LOCAL_NODE_BIND_HOST=127.0.0.1
LOCAL_NODE_PORT=8000
LOCAL_NODE_HTTPS=True
LOCAL_NODE_DB_WAIT_SECONDS=60
LOCAL_NODE_ALLOW_DEBUG_PRINTER=False
PRINTER_BACKEND=network
# Persistent folders OUTSIDE the checkout. Forward slashes work in Windows Python.
LOCAL_MEDIA_ROOT=C:/BigPartyData/media
LOCAL_PRIVATE_ROOT=C:/BigPartyData/private
LOCAL_LOG_ROOT=C:/BigPartyData/log
# Same random key and source identifier on exporter and this node; at least 32 bytes.
ACCESS_SNAPSHOT_SIGNING_KEY=
ACCESS_SNAPSHOT_SOURCE=bigparty-cloud
# Source public URL only parses existing QR URLs; never contacted by local scanner.
PUBLIC_BASE_URL=https://example.invalid
APP_VERSION=
APP_COMMIT=

# Fase 4C: habilitar solo después de revisar identidades/bootstrap.
SYNC_ENABLED=false
SYNC_CLOUD_URL=
SYNC_SHARED_SECRET=
# UUID de LocalNodeIdentity; mismo valor en la configuración Cloud.
SYNC_NODE_UUID=
SYNC_INTERVAL_SECONDS=15
SYNC_BATCH_SIZE=100
SYNC_CONNECT_TIMEOUT=3
SYNC_READ_TIMEOUT=8
SYNC_MAX_BACKOFF_SECONDS=300
SYNC_PROTOCOL_VERSION=1
# Vacío utiliza APP_VERSION. Para una transición, lista explícita separada por comas.
SYNC_COMPATIBLE_APP_VERSIONS=
SYNC_MAX_BODY_BYTES=20971520
SYNC_ALLOW_HTTP_DEVELOPMENT=false

# Fase 4D. Carpetas privadas absolutas, separadas del checkout y media/static.
# Las tres claves DJANGO / SYNC / SNAPSHOT son obligatorias, incluso con sync apagado.
BACKUP_ROOT=D:/BigPartyBackup/primary
BACKUP_SECONDARY_ROOT=D:/BigPartyBackup/secondary
OPERATIONS_STATE_ROOT=C:/BigPartyData/operations
PG_BIN_DIR=C:/Program Files/PostgreSQL/17/bin
BACKUP_KEEP_HOURLY=4
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6
BACKUP_TIMEOUT_SECONDS=1800
BACKUP_MAX_AGE_HOURS=8
MIN_FREE_DISK_GB=2
# JSON argv de adaptador revisado; vacío hasta elegir almacenamiento externo.
BACKUP_OFFSITE_COMMAND=
RECOVERY_MODE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN=20
RATE_LIMIT_PUBLIC=12
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_SYNC=120
SECURITY_HEADERS_ENABLED=true
SYNC_SHARED_SECRET_PREVIOUS=
# ISO 8601 con zona; vencimiento explícito dentro de 24 horas.
SYNC_SECRET_PREVIOUS_UNTIL=
